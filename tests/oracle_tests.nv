@test
fn test_unigram_byte_fallback_0_dummy_prefix_0_gives_the_ids_of_sentencepiece() [io]
    match tokunigram.of_json_pieces(UNI_BF0_DP0, 0)
        Err(e) => test.fail(e.message())
        Ok(u0) =>
            let u = tokunigram.with_dummy_prefix(tokunigram.with_byte_fallback(u0, false), false)
            test.assert_eq(tokunigram.encode(u, "Hello, world!"), [47, 13, 27, 104])
            test.assert_eq(tokunigram.decode(u, [47, 13, 27, 104]), Ok("Hello, world!"))
            test.assert_eq(tokunigram.encode(u, "The quick brown fox"),
                [28, 3, 116, 20, 21, 52, 62, 7, 81, 34, 65, 48])
            test.assert_eq(tokunigram.decode(u, [28, 3, 116, 20, 21, 52, 62, 7, 81, 34, 65, 48]),
                Ok("The quick brown fox"))
            test.assert_eq(tokunigram.encode(u, "don't stop"), [17, 133, 6, 9, 69, 126, 26])
            test.assert_eq(tokunigram.decode(u, [17, 133, 6, 9, 69, 126, 26]), Ok("don't stop"))
            test.assert_eq(tokunigram.encode(u, "  leading and trailing  "),
                [3, 3, 136, 145, 31, 25, 54, 77, 16, 10, 21, 15, 31, 25, 3, 3])
            test.assert_eq(tokunigram.decode(u, [3, 3, 136, 145, 31, 25, 54, 77, 16, 10, 21, 15, 31, 25, 3, 3]),
                Ok("  leading and trailing  "))
            test.assert_eq(tokunigram.encode(u, "a    b"), [10, 3, 3, 3, 14])
            test.assert_eq(tokunigram.decode(u, [10, 3, 3, 3, 14]), Ok("a    b"))
            test.assert_eq(tokunigram.encode(u, "12345 and 678"), [24, 109, 43, 45, 23, 54, 3, 0])
            test.assert_eq(tokunigram.encode(u, "café naïve façade"),
                [84, 150, 50, 29, 10, 117, 19, 3, 142, 103, 10, 38])
            test.assert_eq(tokunigram.decode(u, [84, 150, 50, 29, 10, 117, 19, 3, 142, 103, 10, 38]),
                Ok("café naïve façade"))
            test.assert_eq(tokunigram.encode(u, "日本語のテキスト"), [99, 100, 101, 95, 40, 91, 39])
            test.assert_eq(tokunigram.decode(u, [99, 100, 101, 95, 40, 91, 39]), Ok("日本語のテキスト"))
            test.assert_eq(tokunigram.encode(u, "tab\there\nnew line"),
                [9, 10, 76, 0, 78, 22, 0, 82, 81, 3, 15, 31, 5])
            test.assert_eq(tokunigram.encode(u, "price: \$5.00"), [26, 16, 21, 84, 5, 111, 3, 102, 23, 4, 44, 44])
            test.assert_eq(tokunigram.decode(u, [26, 16, 21, 84, 5, 111, 3, 102, 23, 4, 44, 44]),
                Ok("price: \$5.00"))
            test.assert_eq(tokunigram.encode(u, "x"), [48])
            test.assert_eq(tokunigram.decode(u, [48]), Ok("x"))
            test.assert_eq(tokunigram.encode(u, "It's we're THEY'LL"),
                [153, 9, 6, 8, 132, 5, 6, 22, 130, 154, 0, 115, 6, 0])
            test.assert_eq(tokunigram.encode(u, "emoji 😀 end"), [5, 11, 7, 121, 21, 3, 0, 3, 149, 17])
            test.assert_eq(tokunigram.encode(u, "def add(a, b):\n    return a + b"),
                [38, 66, 55, 106, 10, 13, 14, 107, 111, 0, 3, 3, 3, 70, 56, 35, 3, 108, 14])
            test.assert_eq(tokunigram.encode(u, "unaffable"), [20, 80, 59])
            test.assert_eq(tokunigram.decode(u, [20, 80, 59]), Ok("unaffable"))
            test.assert_eq(tokunigram.encode(u, "Ünïcödé ÀÉÎ"), [0, 34, 117, 84, 0, 17, 50, 3, 0])
            test.assert_eq(tokunigram.encode(u, "\n\n\nthree breaks"), [0, 9, 87, 22, 5, 62, 141, 88, 8])
            test.assert_eq(tokunigram.encode(u, "end."), [149, 17, 4])
            test.assert_eq(tokunigram.decode(u, [149, 17, 4]), Ok("end."))
            test.assert_eq(tokunigram.encode(u, ""), [])
            test.assert_eq(tokunigram.encode(u, "zzz Ωmega"), [49, 49, 49, 3, 0, 11, 5, 25, 10])
            test.assert_eq(tokunigram.encode(u, "hello  world"), [78, 127, 3, 27])
            test.assert_eq(tokunigram.decode(u, [78, 127, 3, 27]), Ok("hello  world"))
