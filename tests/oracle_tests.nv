@test
fn test_unigram_byte_fallback_0_dummy_prefix_1_gives_the_ids_of_sentencepiece() [io]
    match tokunigram.of_json_pieces(UNI_BF0_DP1, 0)
        Err(e) => test.fail(e.message())
        Ok(u0) =>
            let u = tokunigram.with_dummy_prefix(tokunigram.with_byte_fallback(u0, false), true)
            test.assert_eq(tokunigram.encode(u, "Hello, world!"), [55, 13, 27, 93])
            test.assert_eq(tokunigram.decode(u, [55, 13, 27, 93]), Ok("Hello, world!"))
            test.assert_eq(tokunigram.encode(u, "The quick brown fox"),
                [28, 3, 108, 20, 21, 51, 62, 7, 83, 34, 65, 42])
            test.assert_eq(tokunigram.decode(u, [28, 3, 108, 20, 21, 51, 62, 7, 83, 34, 65, 42]),
                Ok("The quick brown fox"))
            test.assert_eq(tokunigram.encode(u, "don't stop"), [131, 133, 6, 9, 70, 124, 25])
            test.assert_eq(tokunigram.decode(u, [131, 133, 6, 9, 70, 124, 25]), Ok("don't stop"))
            test.assert_eq(tokunigram.encode(u, "  leading and trailing  "),
                [3, 3, 3, 135, 144, 31, 24, 53, 79, 16, 10, 21, 15, 31, 24, 3, 3])
            test.assert_eq(tokunigram.decode(u, [3, 3, 3, 135, 144, 31, 24, 53, 79, 16, 10, 21, 15, 31, 24, 3, 3]),
                Ok("  leading and trailing  "))
            test.assert_eq(tokunigram.encode(u, "a    b"), [35, 3, 3, 3, 14])
            test.assert_eq(tokunigram.decode(u, [35, 3, 3, 3, 14]), Ok("a    b"))
            test.assert_eq(tokunigram.encode(u, "12345 and 678"), [3, 26, 106, 46, 40, 23, 53, 3, 0])
            test.assert_eq(tokunigram.encode(u, "café naïve façade"),
                [73, 67, 44, 30, 10, 91, 19, 3, 139, 103, 10, 66])
            test.assert_eq(tokunigram.decode(u, [73, 67, 44, 30, 10, 91, 19, 3, 139, 103, 10, 66]),
                Ok("café naïve façade"))
            test.assert_eq(tokunigram.encode(u, "日本語のテキスト"), [3, 116, 118, 119, 120, 50, 122, 49])
            test.assert_eq(tokunigram.decode(u, [3, 116, 118, 119, 120, 50, 122, 49]),
                Ok("日本語のテキスト"))
            test.assert_eq(tokunigram.encode(u, "tab\there\nnew line"),
                [79, 10, 77, 0, 78, 22, 0, 81, 83, 3, 15, 31, 5])
            test.assert_eq(tokunigram.encode(u, "price: \$5.00"),
                [3, 25, 16, 21, 84, 5, 99, 3, 95, 23, 4, 39, 39])
            test.assert_eq(tokunigram.decode(u, [3, 25, 16, 21, 84, 5, 99, 3, 95, 23, 4, 39, 39]),
                Ok("price: \$5.00"))
            test.assert_eq(tokunigram.encode(u, "x"), [3, 42])
            test.assert_eq(tokunigram.decode(u, [3, 42]), Ok("x"))
            test.assert_eq(tokunigram.encode(u, "It's we're THEY'LL"),
                [45, 9, 6, 8, 132, 5, 6, 22, 38, 153, 0, 102, 6, 0])
            test.assert_eq(tokunigram.encode(u, "emoji 😀 end"), [3, 5, 11, 7, 107, 21, 3, 0, 3, 148, 17])
            test.assert_eq(tokunigram.encode(u, "def add(a, b):\n    return a + b"),
                [3, 66, 67, 56, 89, 10, 13, 14, 96, 99, 0, 3, 3, 3, 72, 54, 35, 3, 97, 14])
            test.assert_eq(tokunigram.encode(u, "unaffable"), [32, 134, 59])
            test.assert_eq(tokunigram.decode(u, [32, 134, 59]), Ok("unaffable"))
            test.assert_eq(tokunigram.encode(u, "Ünïcödé ÀÉÎ"), [3, 0, 34, 91, 84, 0, 17, 44, 3, 0])
            test.assert_eq(tokunigram.encode(u, "\n\n\nthree breaks"), [3, 0, 9, 87, 22, 5, 62, 140, 88, 8])
            test.assert_eq(tokunigram.encode(u, "end."), [3, 148, 17, 4])
            test.assert_eq(tokunigram.decode(u, [3, 148, 17, 4]), Ok("end."))
            test.assert_eq(tokunigram.encode(u, ""), [])
            test.assert_eq(tokunigram.encode(u, "zzz Ωmega"), [3, 43, 43, 43, 3, 0, 11, 5, 24, 10])
            test.assert_eq(tokunigram.encode(u, "hello  world"), [69, 127, 3, 27])
            test.assert_eq(tokunigram.decode(u, [69, 127, 3, 27]), Ok("hello  world"))

