@test
fn test_byte_level_bpe_gives_the_ids_of_huggingface_tokenizers() [io]
    match tokbpe.of_gpt2_files(BPE_VOCAB, BPE_MERGES, TokPretokenGpt2)
        Err(e) => test.fail(e.message())
        Ok(b)  =>
            test.assert_eq(tokbpe.encode(b, "Hello, world!"), [328, 12, 294, 1])
            test.assert_eq(tokbpe.decode(b, [328, 12, 294, 1]), Ok("Hello, world!"))
            test.assert_eq(tokbpe.encode(b, "The quick brown fox"), [280, 221, 393, 370, 260, 394, 78, 275, 387])
            test.assert_eq(tokbpe.decode(b, [280, 221, 393, 370, 260, 394, 78, 275, 387]),
                Ok("The quick brown fox"))
            test.assert_eq(tokbpe.encode(b, "don't stop"), [68, 305, 334, 265, 84, 79, 80])
            test.assert_eq(tokbpe.decode(b, [68, 305, 334, 265, 84, 79, 80]), Ok("don't stop"))
            test.assert_eq(tokbpe.encode(b, "  leading and trailing  "),
                [221, 221, 286, 298, 269, 71, 319, 258, 82, 65, 73, 76, 269, 71, 314])
            test.assert_eq(tokbpe.decode(b, [221, 221, 286, 298, 269, 71, 319, 258, 82, 65, 73, 76, 269, 71, 314]),
                Ok("  leading and trailing  "))
            test.assert_eq(tokbpe.encode(b, "a    b"), [65, 314, 221, 260])
            test.assert_eq(tokbpe.decode(b, [65, 314, 221, 260]), Ok("a    b"))
            test.assert_eq(tokbpe.encode(b, "12345 and 678"), [338, 341, 21, 319, 221, 22, 23, 24])
            test.assert_eq(tokbpe.decode(b, [338, 341, 21, 319, 221, 22, 23, 24]), Ok("12345 and 678"))
            test.assert_eq(tokbpe.encode(b, "café naïve façade"), [67, 282, 311, 276, 299, 407, 275, 299, 402])
            test.assert_eq(tokbpe.decode(b, [67, 282, 311, 276, 299, 407, 275, 299, 402]),
                Ok("café naïve façade"))
            test.assert_eq(tokbpe.encode(b, "日本語のテキスト"),
                [414, 400, 251, 405, 404, 259, 406, 256, 267, 329])
            test.assert_eq(tokbpe.decode(b, [414, 400, 251, 405, 404, 259, 406, 256, 267, 329]),
                Ok("日本語のテキスト"))
            test.assert_eq(tokbpe.encode(b, "tab\there\nnew line"),
                [84, 281, 198, 257, 261, 199, 78, 69, 87, 221, 76, 269, 69])
            test.assert_eq(tokbpe.decode(b, [84, 281, 198, 257, 261, 199, 78, 69, 87, 221, 76, 269, 69]),
                Ok("tab\there\nnew line"))
            test.assert_eq(tokbpe.encode(b, "price: \$5.00"), [80, 82, 73, 67, 69, 26, 416, 21, 14, 337])
            test.assert_eq(tokbpe.decode(b, [80, 82, 73, 67, 69, 26, 416, 21, 14, 337]), Ok("price: \$5.00"))
            test.assert_eq(tokbpe.encode(b, "x"), [88])
            test.assert_eq(tokbpe.decode(b, [88]), Ok("x"))
            test.assert_eq(tokbpe.encode(b, "It's we're THEY'LL"),
                [41, 84, 333, 277, 69, 295, 221, 52, 40, 37, 57, 7, 44, 44])
            test.assert_eq(tokbpe.decode(b, [41, 84, 333, 277, 69, 295, 221, 52, 40, 37, 57, 7, 44, 44]),
                Ok("It's we're THEY'LL"))
            test.assert_eq(tokbpe.encode(b, "emoji 😀 end"),
                [69, 380, 74, 73, 221, 173, 254, 247, 223, 221, 284, 68])
            test.assert_eq(tokbpe.decode(b, [69, 380, 74, 73, 221, 173, 254, 247, 223, 221, 284, 68]),
                Ok("emoji 😀 end"))
            test.assert_eq(tokbpe.encode(b, "def add(a, b):\n    return a + b"),
                [268, 70, 318, 68, 8, 65, 12, 260, 336, 199, 314, 221, 278, 395, 262, 417, 260])
            test.assert_eq(tokbpe.decode(b, [268, 70, 318, 68, 8, 65, 12, 260, 336, 199, 314, 221, 278, 395, 262, 417, 260]),
                Ok("def add(a, b):\n    return a + b"))
            test.assert_eq(tokbpe.encode(b, "unaffable"), [288, 326, 325])
            test.assert_eq(tokbpe.decode(b, [288, 326, 325]), Ok("unaffable"))
            test.assert_eq(tokbpe.encode(b, "Ünïcödé ÀÉÎ"),
                [128, 251, 78, 128, 108, 67, 128, 115, 68, 311, 221, 128, 223, 128, 232, 128, 237])
            test.assert_eq(tokbpe.decode(b, [128, 251, 78, 128, 108, 67, 128, 115, 68, 311, 221, 128, 223, 128, 232, 128, 237]),
                Ok("Ünïcödé ÀÉÎ"))
            test.assert_eq(tokbpe.encode(b, "\n\n\nthree breaks"),
                [199, 199, 199, 84, 72, 261, 69, 260, 261, 65, 75, 83])
            test.assert_eq(tokbpe.decode(b, [199, 199, 199, 84, 72, 261, 69, 260, 261, 65, 75, 83]),
                Ok("\n\n\nthree breaks"))
            test.assert_eq(tokbpe.encode(b, "end."), [284, 68, 14])
            test.assert_eq(tokbpe.decode(b, [284, 68, 14]), Ok("end."))
            test.assert_eq(tokbpe.encode(b, ""), [])
            test.assert_eq(tokbpe.decode(b, []), Ok(""))

@test
fn test_a_tokenizer_json_loads_to_the_same_byte_level_bpe() [io]
    match tokmodel.of_tokenizer_json(BPE_JSON)
        Err(e) => test.fail(e.message())
        Ok(m)  =>
            test.assert_eq(tokmodel.model_name(m), "BPE")
            test.assert_eq(tokmodel.encode(m, "Hello, world!").ids, [328, 12, 294, 1])
            test.assert_eq(tokmodel.encode(m, "The quick brown fox").ids,
                [280, 221, 393, 370, 260, 394, 78, 275, 387])
            test.assert_eq(tokmodel.encode(m, "don't stop").ids, [68, 305, 334, 265, 84, 79, 80])
            test.assert_eq(tokmodel.encode(m, "  leading and trailing  ").ids,
                [221, 221, 286, 298, 269, 71, 319, 258, 82, 65, 73, 76, 269, 71, 314])
            test.assert_eq(tokmodel.encode(m, "a    b").ids, [65, 314, 221, 260])
            test.assert_eq(tokmodel.encode(m, "12345 and 678").ids, [338, 341, 21, 319, 221, 22, 23, 24])
            test.assert_eq(tokmodel.encode(m, "café naïve façade").ids,
                [67, 282, 311, 276, 299, 407, 275, 299, 402])
            test.assert_eq(tokmodel.encode(m, "日本語のテキスト").ids,
                [414, 400, 251, 405, 404, 259, 406, 256, 267, 329])
            test.assert_eq(tokmodel.encode(m, "tab\there\nnew line").ids,
                [84, 281, 198, 257, 261, 199, 78, 69, 87, 221, 76, 269, 69])
            test.assert_eq(tokmodel.encode(m, "price: \$5.00").ids, [80, 82, 73, 67, 69, 26, 416, 21, 14, 337])
            test.assert_eq(tokmodel.encode(m, "x").ids, [88])
            test.assert_eq(tokmodel.encode(m, "It's we're THEY'LL").ids,
                [41, 84, 333, 277, 69, 295, 221, 52, 40, 37, 57, 7, 44, 44])
            test.assert_eq(tokmodel.encode(m, "emoji 😀 end").ids,
                [69, 380, 74, 73, 221, 173, 254, 247, 223, 221, 284, 68])
            test.assert_eq(tokmodel.encode(m, "def add(a, b):\n    return a + b").ids,
                [268, 70, 318, 68, 8, 65, 12, 260, 336, 199, 314, 221, 278, 395, 262, 417, 260])
            test.assert_eq(tokmodel.encode(m, "unaffable").ids, [288, 326, 325])
            test.assert_eq(tokmodel.encode(m, "Ünïcödé ÀÉÎ").ids,
                [128, 251, 78, 128, 108, 67, 128, 115, 68, 311, 221, 128, 223, 128, 232, 128, 237])
            test.assert_eq(tokmodel.encode(m, "\n\n\nthree breaks").ids,
                [199, 199, 199, 84, 72, 261, 69, 260, 261, 65, 75, 83])
            test.assert_eq(tokmodel.encode(m, "end.").ids, [284, 68, 14])
            test.assert_eq(tokmodel.encode(m, "").ids, [])
            test.assert_eq(tokmodel.encode(m, "a<|endoftext|>b").ids, [65, 0, 66])

