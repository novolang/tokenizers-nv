@test
fn test_unigram_byte_fallback_1_dummy_prefix_1_gives_the_ids_of_sentencepiece() [io]
    match tokunigram.of_json_pieces(UNI_BF1_DP1, 0)
        Err(e) => test.fail(e.message())
        Ok(u0) =>
            let u = tokunigram.with_dummy_prefix(tokunigram.with_byte_fallback(u0, true), true)
            test.assert_eq(tokunigram.encode(u, "Hello, world!"), [311, 269, 283, 349])
            test.assert_eq(tokunigram.decode(u, [311, 269, 283, 349]), Ok("Hello, world!"))
            test.assert_eq(tokunigram.encode(u, "The quick brown fox"),
                [284, 259, 364, 276, 277, 307, 318, 263, 339, 290, 321, 298])
            test.assert_eq(tokunigram.decode(u, [284, 259, 364, 276, 277, 307, 318, 263, 339, 290, 321, 298]),
                Ok("The quick brown fox"))
            test.assert_eq(tokunigram.encode(u, "don't stop"), [387, 389, 262, 265, 326, 380, 281])
            test.assert_eq(tokunigram.decode(u, [387, 389, 262, 265, 326, 380, 281]), Ok("don't stop"))
            test.assert_eq(tokunigram.encode(u, "  leading and trailing  "),
                [259, 259, 259, 391, 400, 287, 280, 309, 335, 272, 266, 277, 271, 287, 280, 259, 259])
            test.assert_eq(tokunigram.decode(u,
                [259, 259, 259, 391, 400, 287, 280, 309, 335, 272, 266, 277, 271, 287, 280, 259, 259]),
            Ok("  leading and trailing  "))
            test.assert_eq(tokunigram.encode(u, "a    b"), [291, 259, 259, 259, 270])
            test.assert_eq(tokunigram.decode(u, [291, 259, 259, 259, 270]), Ok("a    b"))
            test.assert_eq(tokunigram.encode(u, "12345 and 678"),
                [259, 282, 362, 302, 296, 279, 309, 259, 57, 58, 59])
            test.assert_eq(tokunigram.decode(u, [259, 282, 362, 302, 296, 279, 309, 259, 57, 58, 59]),
                Ok("12345 and 678"))
            test.assert_eq(tokunigram.encode(u, "café naïve façade"),
                [329, 323, 300, 286, 266, 347, 275, 259, 395, 359, 266, 322])
            test.assert_eq(tokunigram.decode(u, [329, 323, 300, 286, 266, 347, 275, 259, 395, 359, 266, 322]),
                Ok("café naïve façade"))
            test.assert_eq(tokunigram.encode(u, "日本語のテキスト"),
                [259, 372, 374, 375, 376, 306, 378, 305])
            test.assert_eq(tokunigram.decode(u, [259, 372, 374, 375, 376, 306, 378, 305]),
                Ok("日本語のテキスト"))
            test.assert_eq(tokunigram.encode(u, "tab\there\nnew line"),
                [335, 266, 333, 12, 334, 278, 13, 337, 339, 259, 271, 287, 261])
            test.assert_eq(tokunigram.decode(u, [335, 266, 333, 12, 334, 278, 13, 337, 339, 259, 271, 287, 261]),
                Ok("tab\there\nnew line"))
            test.assert_eq(tokunigram.encode(u, "price: \$5.00"),
                [259, 281, 272, 277, 340, 261, 355, 259, 351, 279, 260, 295, 295])
            test.assert_eq(tokunigram.decode(u, [259, 281, 272, 277, 340, 261, 355, 259, 351, 279, 260, 295, 295]),
                Ok("price: \$5.00"))
            test.assert_eq(tokunigram.encode(u, "x"), [259, 298])
            test.assert_eq(tokunigram.decode(u, [259, 298]), Ok("x"))
            test.assert_eq(tokunigram.encode(u, "It's we're THEY'LL"),
                [301, 265, 262, 264, 388, 261, 262, 278, 294, 409, 72, 358, 262, 79, 79])
            test.assert_eq(tokunigram.decode(u, [301, 265, 262, 264, 388, 261, 262, 278, 294, 409, 72, 358, 262, 79, 79]),
                Ok("It's we're THEY'LL"))
            test.assert_eq(tokunigram.encode(u, "emoji 😀 end"),
                [259, 261, 267, 263, 363, 277, 259, 243, 162, 155, 131, 259, 404, 273])
            test.assert_eq(tokunigram.decode(u, [259, 261, 267, 263, 363, 277, 259, 243, 162, 155, 131, 259, 404, 273]),
                Ok("emoji 😀 end"))
            test.assert_eq(tokunigram.encode(u, "def add(a, b):\n    return a + b"), [259,
                322,
                323,
                312,
                345,
                266,
                269,
                270,
                352,
                355,
                13,
                259,
                259,
                259,
                328,
                310,
                291,
                259,
                353,
                270])
            test.assert_eq(tokunigram.decode(u, [259,
                322,
                323,
                312,
                345,
                266,
                269,
                270,
                352,
                355,
                13,
                259,
                259,
                259,
                328,
                310,
                291,
                259,
                353,
                270]),
            Ok("def add(a, b):\n    return a + b"))
            test.assert_eq(tokunigram.encode(u, "unaffable"), [288, 390, 315])
            test.assert_eq(tokunigram.decode(u, [288, 390, 315]), Ok("unaffable"))
            test.assert_eq(tokunigram.encode(u, "Ünïcödé ÀÉÎ"),
                [259, 198, 159, 290, 347, 340, 198, 185, 273, 300, 259, 198, 131, 198, 140, 198, 145])
            test.assert_eq(tokunigram.decode(u,
                [259, 198, 159, 290, 347, 340, 198, 185, 273, 300, 259, 198, 131, 198, 140, 198, 145]),
            Ok("Ünïcödé ÀÉÎ"))
            test.assert_eq(tokunigram.encode(u, "\n\n\nthree breaks"),
                [259, 13, 13, 13, 265, 343, 278, 261, 318, 396, 344, 264])
            test.assert_eq(tokunigram.decode(u, [259, 13, 13, 13, 265, 343, 278, 261, 318, 396, 344, 264]),
                Ok("\n\n\nthree breaks"))
            test.assert_eq(tokunigram.encode(u, "end."), [259, 404, 273, 260])
            test.assert_eq(tokunigram.decode(u, [259, 404, 273, 260]), Ok("end."))
            test.assert_eq(tokunigram.encode(u, ""), [])
            test.assert_eq(tokunigram.encode(u, "zzz Ωmega"),
                [259, 299, 299, 299, 259, 209, 172, 267, 261, 280, 266])
            test.assert_eq(tokunigram.decode(u, [259, 299, 299, 299, 259, 209, 172, 267, 261, 280, 266]),
                Ok("zzz Ωmega"))
            test.assert_eq(tokunigram.encode(u, "hello  world"), [325, 383, 259, 283])
            test.assert_eq(tokunigram.decode(u, [325, 383, 259, 283]), Ok("hello  world"))

