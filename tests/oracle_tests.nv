    test.assert_eq(tokbpe.pretokenize(TokPretokenLlama3, "(a)[b]{c}\n\n"), ["(a", ")[", "b", "]{", "c", "}\n\n"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenLlama3, "'s"), ["'s"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenLlama3, "é combining"), ["e", "́", " combining"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenLlama3, "\u{A0}nbsp\u{2003}em"), ["\u{A0}nbsp", "\u{2003}em"])
    test.case("Qwen2: 26 strings")
    test.assert_eq(tokbpe.pretokenize(TokPretokenQwen2, "Hello, world!"), ["Hello", ",", " world", "!"])
