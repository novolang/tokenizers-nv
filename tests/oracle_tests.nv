@test
fn test_wordpiece_uncased_gives_the_ids_of_huggingface_tokenizers() [io]
    match tokpiece.of_vocab_text(WP_UNCASED_VOCAB, "[UNK]")
        Err(e) => test.fail(e.message())
        Ok(w0) =>
            let w = tokpiece.with_normalizer(w0, tokpiece.bert_uncased_rules())
            test.assert_eq(tokpiece.encode(w, "Hello, world!"), [132, 12, 133, 5])
            test.assert_eq(tokpiece.encode(w, "The quick brown fox"), [111, 191, 215, 86, 253, 72, 174, 98])
            test.assert_eq(tokpiece.encode(w, "don't stop"), [170, 72, 8, 43, 42, 200, 109])
            test.assert_eq(tokpiece.encode(w, "  leading and trailing  "),
                [35, 74, 130, 122, 85, 158, 43, 87, 78, 76, 75, 122, 85])
            test.assert_eq(tokpiece.encode(w, "a    b"), [24, 25])
            test.assert_eq(tokpiece.encode(w, "12345 and 678"), [162, 238, 158, 1])
            test.assert_eq(tokpiece.encode(w, "café naïve façade"), [169, 74, 186, 214, 74, 177, 248])
            test.assert_eq(tokpiece.encode(w, "日本語のテキスト"), [66, 67, 68, 199, 235])
            test.assert_eq(tokpiece.encode(w, "tab\there\nnew line"), [43, 128, 178, 74, 185, 83, 35, 122, 74])
            test.assert_eq(tokpiece.encode(w, "price: \$5.00"), [39, 87, 215, 74, 21, 7, 19, 13, 160])
            test.assert_eq(tokpiece.encode(w, "x"), [47])
            test.assert_eq(tokpiece.encode(w, "It's we're THEY'LL"), [138, 8, 42, 143, 8, 112, 152, 8, 181])
            test.assert_eq(tokpiece.encode(w, "emoji 😀 end"), [1, 1, 28, 72, 81])
            test.assert_eq(tokpiece.encode(w, "def add(a, b):\n    return a + b"),
                [171, 79, 249, 9, 24, 12, 25, 10, 21, 240, 150, 24, 11, 25])
            test.assert_eq(tokpiece.encode(w, "unaffable"), [159, 157])
            test.assert_eq(tokpiece.encode(w, "Ünïcödé ÀÉÎ"), [117, 215, 70, 81, 74, 24, 74, 76])
            test.assert_eq(tokpiece.encode(w, "\n\n\nthree breaks"), [43, 82, 87, 74, 74, 137, 74, 78, 86, 88])
            test.assert_eq(tokpiece.encode(w, "end."), [28, 72, 81, 13])
            test.assert_eq(tokpiece.encode(w, ""), [])
            test.assert_eq(tokpiece.encode(w, "Hello, World! (Test) \$5 + 3"),
                [132, 12, 133, 5, 9, 195, 88, 69, 10, 7, 19, 11, 17])
            test.assert_eq(tokpiece.encode(w, "A\u{A0}B\u{2003}C"), [24, 25, 26])
            test.assert_eq(tokpiece.encode(w, "漢字kanji"), [1, 1, 1])
            test.assert_eq(tokpiece.encode(w, "ﬁne ①"), [1, 1])

@test
fn test_a_tokenizer_json_loads_to_the_same_wordpiece_uncased() [io]
    match tokmodel.of_tokenizer_json(WP_UNCASED_JSON)
        Err(e) => test.fail(e.message())
        Ok(m)  =>
            test.assert_eq(tokmodel.model_name(m), "WordPiece")
            test.assert_eq(tokmodel.encode(m, "Hello, world!").ids, [132, 12, 133, 5])
            test.assert_eq(tokmodel.encode(m, "The quick brown fox").ids, [111, 191, 215, 86, 253, 72, 174, 98])
            test.assert_eq(tokmodel.encode(m, "don't stop").ids, [170, 72, 8, 43, 42, 200, 109])
            test.assert_eq(tokmodel.encode(m, "  leading and trailing  ").ids,
                [35, 74, 130, 122, 85, 158, 43, 87, 78, 76, 75, 122, 85])
            test.assert_eq(tokmodel.encode(m, "a    b").ids, [24, 25])
            test.assert_eq(tokmodel.encode(m, "12345 and 678").ids, [162, 238, 158, 1])
            test.assert_eq(tokmodel.encode(m, "café naïve façade").ids, [169, 74, 186, 214, 74, 177, 248])
            test.assert_eq(tokmodel.encode(m, "日本語のテキスト").ids, [66, 67, 68, 199, 235])
            test.assert_eq(tokmodel.encode(m, "tab\there\nnew line").ids,
                [43, 128, 178, 74, 185, 83, 35, 122, 74])
            test.assert_eq(tokmodel.encode(m, "price: \$5.00").ids, [39, 87, 215, 74, 21, 7, 19, 13, 160])
            test.assert_eq(tokmodel.encode(m, "x").ids, [47])
            test.assert_eq(tokmodel.encode(m, "It's we're THEY'LL").ids, [138, 8, 42, 143, 8, 112, 152, 8, 181])
            test.assert_eq(tokmodel.encode(m, "emoji 😀 end").ids, [1, 1, 28, 72, 81])
            test.assert_eq(tokmodel.encode(m, "def add(a, b):\n    return a + b").ids,
                [171, 79, 249, 9, 24, 12, 25, 10, 21, 240, 150, 24, 11, 25])
            test.assert_eq(tokmodel.encode(m, "unaffable").ids, [159, 157])
            test.assert_eq(tokmodel.encode(m, "Ünïcödé ÀÉÎ").ids, [117, 215, 70, 81, 74, 24, 74, 76])
            test.assert_eq(tokmodel.encode(m, "\n\n\nthree breaks").ids,
                [43, 82, 87, 74, 74, 137, 74, 78, 86, 88])
            test.assert_eq(tokmodel.encode(m, "end.").ids, [28, 72, 81, 13])
            test.assert_eq(tokmodel.encode(m, "").ids, [])

