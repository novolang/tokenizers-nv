// oracle_tests.nv — answers recorded from the reference implementations.
//
// Generated by tests/oracle/gen_vectors.py; do not edit by hand.  The
// byte-level BPE and WordPiece answers are HuggingFace tokenizers'; the
// unigram answers are sentencepiece's; the pre-tokenizer splits are what
// the `regex` module finds with each rule's published pattern.  The
// vocabularies are small ones trained from a few sentences, so the file is
// self-contained and no vocabulary is read from disk.

use std.test
use tokbpe
use tokunigram
use tokpiece
use tokmodel

@test
fn test_the_pretokenizer_rules_split_where_the_regular_expressions_do() [io]
    test.case("GPT-2: 26 strings")
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "Hello, world!"), ["Hello", ",", " world", "!"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "The quick brown fox"),
        ["The", " quick", " brown", " fox"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "don't stop"), ["don", "'t", " stop"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "  leading and trailing  "),
        [" ", " leading", " and", " trailing", "  "])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "a    b"), ["a", "   ", " b"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "12345 and 678"), ["12345", " and", " 678"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "café naïve façade"), ["café", " naïve", " façade"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "日本語のテキスト"), ["日本語のテキスト"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "tab\there\nnew line"),
        ["tab", "\t", "here", "\n", "new", " line"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "price: \$5.00"), ["price", ":", " \$", "5", ".", "00"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "x"), ["x"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "It's we're THEY'LL"),
        ["It", "'s", " we", "'re", " THEY", "'", "LL"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "emoji 😀 end"), ["emoji", " 😀", " end"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "def add(a, b):\n    return a + b"),
        ["def", " add", "(", "a", ",", " b", "):", "\n   ", " return", " a", " +", " b"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "unaffable"), ["unaffable"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "Ünïcödé ÀÉÎ"), ["Ünïcödé", " ÀÉÎ"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "\n\n\nthree breaks"), ["\n\n", "\n", "three", " breaks"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "end."), ["end", "."])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, ""), [])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "a\r\nb"), ["a", "\r", "\n", "b"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "1 2 3"), ["1", " 2", " 3"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "x  y   z"), ["x", " ", " y", "  ", " z"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "(a)[b]{c}\n\n"),
        ["(", "a", ")[", "b", "]{", "c", "}", "\n\n"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "'s"), ["'s"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "é combining"), ["e", "́", " combining"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenGpt2, "\u{A0}nbsp\u{2003}em"),
        ["\u{A0}", "nbsp", "\u{2003}", "em"])
    test.case("Llama 3: 26 strings")
    test.assert_eq(tokbpe.pretokenize(TokPretokenLlama3, "Hello, world!"), ["Hello", ",", " world", "!"])
    test.assert_eq(tokbpe.pretokenize(TokPretokenLlama3, "The quick brown fox"),
