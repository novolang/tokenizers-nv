@test
fn test_unigram_byte_fallback_1_dummy_prefix_0_gives_the_ids_of_sentencepiece() [io]
    match tokunigram.of_json_pieces(UNI_BF1_DP0, 0)
        Err(e) => test.fail(e.message())
        Ok(u0) =>
            let u = tokunigram.with_dummy_prefix(tokunigram.with_byte_fallback(u0, true), false)
            test.assert_eq(tokunigram.encode(u, "Hello, world!"), [303, 269, 283, 360])
            test.assert_eq(tokunigram.decode(u, [303, 269, 283, 360]), Ok("Hello, world!"))
            test.assert_eq(tokunigram.encode(u, "The quick brown fox"),
                [284, 259, 372, 276, 277, 308, 318, 263, 337, 290, 321, 304])
            test.assert_eq(tokunigram.decode(u, [284, 259, 372, 276, 277, 308, 318, 263, 337, 290, 321, 304]),
                Ok("The quick brown fox"))
            test.assert_eq(tokunigram.encode(u, "don't stop"), [273, 389, 262, 265, 325, 382, 282])
            test.assert_eq(tokunigram.decode(u, [273, 389, 262, 265, 325, 382, 282]), Ok("don't stop"))
            test.assert_eq(tokunigram.encode(u, "  leading and trailing  "),
                [259, 259, 392, 401, 287, 281, 310, 333, 272, 266, 277, 271, 287, 281, 259, 259])
            test.assert_eq(tokunigram.decode(u, [259, 259, 392, 401, 287, 281, 310, 333, 272, 266, 277, 271, 287, 281, 259, 259]),
                Ok("  leading and trailing  "))
            test.assert_eq(tokunigram.encode(u, "a    b"), [266, 259, 259, 259, 270])
            test.assert_eq(tokunigram.decode(u, [266, 259, 259, 259, 270]), Ok("a    b"))
            test.assert_eq(tokunigram.encode(u, "12345 and 678"), [280, 365, 299, 301, 279, 310, 259, 57, 58, 59])
            test.assert_eq(tokunigram.decode(u, [280, 365, 299, 301, 279, 310, 259, 57, 58, 59]),
                Ok("12345 and 678"))
            test.assert_eq(tokunigram.encode(u, "café naïve façade"),
                [340, 406, 306, 285, 266, 373, 275, 259, 398, 359, 266, 294])
            test.assert_eq(tokunigram.decode(u, [340, 406, 306, 285, 266, 373, 275, 259, 398, 359, 266, 294]),
                Ok("café naïve façade"))
            test.assert_eq(tokunigram.encode(u, "日本語のテキスト"), [355, 356, 357, 351, 296, 347, 295])
            test.assert_eq(tokunigram.decode(u, [355, 356, 357, 351, 296, 347, 295]),
                Ok("日本語のテキスト"))
            test.assert_eq(tokunigram.encode(u, "tab\there\nnew line"),
                [265, 266, 332, 12, 334, 278, 13, 338, 337, 259, 271, 287, 261])
            test.assert_eq(tokunigram.decode(u, [265, 266, 332, 12, 334, 278, 13, 338, 337, 259, 271, 287, 261]),
                Ok("tab\there\nnew line"))
            test.assert_eq(tokunigram.encode(u, "price: \$5.00"),
                [282, 272, 277, 340, 261, 367, 259, 358, 279, 260, 300, 300])
            test.assert_eq(tokunigram.decode(u, [282, 272, 277, 340, 261, 367, 259, 358, 279, 260, 300, 300]),
                Ok("price: \$5.00"))
            test.assert_eq(tokunigram.encode(u, "x"), [304])
            test.assert_eq(tokunigram.decode(u, [304]), Ok("x"))
            test.assert_eq(tokunigram.encode(u, "It's we're THEY'LL"),
                [409, 265, 262, 264, 388, 261, 262, 278, 386, 410, 72, 371, 262, 79, 79])
            test.assert_eq(tokunigram.decode(u, [409, 265, 262, 264, 388, 261, 262, 278, 386, 410, 72, 371, 262, 79, 79]),
                Ok("It's we're THEY'LL"))
            test.assert_eq(tokunigram.encode(u, "emoji 😀 end"),
                [261, 267, 263, 377, 277, 259, 243, 162, 155, 131, 259, 405, 273])
            test.assert_eq(tokunigram.decode(u, [261, 267, 263, 377, 277, 259, 243, 162, 155, 131, 259, 405, 273]),
                Ok("emoji 😀 end"))
            test.assert_eq(tokunigram.encode(u, "def add(a, b):\n    return a + b"), [294,
                322,
                311,
                362,
                266,
                269,
                270,
                363,
                367,
                13,
                259,
                259,
                259,
                326,
                312,
                291,
                259,
                364,
                270])
            test.assert_eq(tokunigram.decode(u, [294,
                322,
                311,
                362,
                266,
                269,
                270,
                363,
                367,
                13,
                259,
                259,
                259,
                326,
                312,
                291,
                259,
                364,
                270]),
            Ok("def add(a, b):\n    return a + b"))
            test.assert_eq(tokunigram.encode(u, "unaffable"), [276, 336, 315])
            test.assert_eq(tokunigram.decode(u, [276, 336, 315]), Ok("unaffable"))
            test.assert_eq(tokunigram.encode(u, "Ünïcödé ÀÉÎ"),
                [198, 159, 290, 373, 340, 198, 185, 273, 306, 259, 198, 131, 198, 140, 198, 145])
            test.assert_eq(tokunigram.decode(u, [198, 159, 290, 373, 340, 198, 185, 273, 306, 259, 198, 131, 198, 140, 198, 145]),
                Ok("Ünïcödé ÀÉÎ"))
            test.assert_eq(tokunigram.encode(u, "\n\n\nthree breaks"),
                [13, 13, 13, 265, 343, 278, 261, 318, 397, 344, 264])
            test.assert_eq(tokunigram.decode(u, [13, 13, 13, 265, 343, 278, 261, 318, 397, 344, 264]),
                Ok("\n\n\nthree breaks"))
            test.assert_eq(tokunigram.encode(u, "end."), [405, 273, 260])
            test.assert_eq(tokunigram.decode(u, [405, 273, 260]), Ok("end."))
            test.assert_eq(tokunigram.encode(u, ""), [])
            test.assert_eq(tokunigram.encode(u, "zzz Ωmega"), [305, 305, 305, 259, 209, 172, 267, 261, 281, 266])
            test.assert_eq(tokunigram.decode(u, [305, 305, 305, 259, 209, 172, 267, 261, 281, 266]),
                Ok("zzz Ωmega"))
            test.assert_eq(tokunigram.encode(u, "hello  world"), [334, 383, 259, 283])
            test.assert_eq(tokunigram.decode(u, [334, 383, 259, 283]), Ok("hello  world"))

