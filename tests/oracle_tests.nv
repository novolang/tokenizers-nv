@test
fn test_wordpiece_cased_gives_the_ids_of_huggingface_tokenizers() [io]
    match tokpiece.of_vocab_text(WP_CASED_VOCAB, "[UNK]")
        Err(e) => test.fail(e.message())
        Ok(w0) =>
            let w = tokpiece.with_normalizer(w0, tokpiece.bert_cased_rules())
            test.assert_eq(tokpiece.encode(w, "Hello, world!"), [151, 12, 150, 5])
            test.assert_eq(tokpiece.encode(w, "The quick brown fox"), [137, 212, 237, 155, 230, 87, 194, 124])
            test.assert_eq(tokpiece.encode(w, "don't stop"), [189, 87, 8, 50, 49, 256, 110])
            test.assert_eq(tokpiece.encode(w, "  leading and trailing  "),
                [42, 86, 142, 135, 91, 172, 50, 89, 81, 88, 97, 135, 91])
            test.assert_eq(tokpiece.encode(w, "a    b"), [31, 32])
            test.assert_eq(tokpiece.encode(w, "12345 and 678"), [174, 253, 104, 172, 1])
            test.assert_eq(tokpiece.encode(w, "café naïve façade"),
                [188, 107, 205, 123, 242, 193, 126, 142, 86])
            test.assert_eq(tokpiece.encode(w, "日本語のテキスト"), [78, 79, 80, 223, 114, 166])
            test.assert_eq(tokpiece.encode(w, "tab\there\nnew line"), [50, 143, 197, 86, 207, 118, 42, 135, 86])
            test.assert_eq(tokpiece.encode(w, "price: \$5.00"), [46, 89, 88, 105, 86, 21, 7, 19, 13, 173])
            test.assert_eq(tokpiece.encode(w, "x"), [54])
            test.assert_eq(tokpiece.encode(w, "It's we're THEY'LL"), [176, 8, 49, 219, 8, 128, 1, 8, 1])
            test.assert_eq(tokpiece.encode(w, "emoji 😀 end"), [1, 1, 35, 87, 93])
            test.assert_eq(tokpiece.encode(w, "def add(a, b):\n    return a + b"),
                [190, 108, 153, 93, 9, 31, 12, 32, 10, 21, 128, 257, 31, 11, 32])
            test.assert_eq(tokpiece.encode(w, "unaffable"), [140, 171, 170])
            test.assert_eq(tokpiece.encode(w, "Ünïcödé ÀÉÎ"), [1, 1])
            test.assert_eq(tokpiece.encode(w, "\n\n\nthree breaks"), [50, 95, 89, 86, 86, 155, 86, 81, 85, 90])
            test.assert_eq(tokpiece.encode(w, "end."), [35, 87, 93, 13])
            test.assert_eq(tokpiece.encode(w, ""), [])
            test.assert_eq(tokpiece.encode(w, "Hello, World! (Test) \$5 + 3"),
                [151, 12, 29, 133, 136, 5, 9, 27, 160, 109, 10, 7, 19, 11, 17])
            test.assert_eq(tokpiece.encode(w, "A\u{A0}B\u{2003}C"), [24, 1, 1])
            test.assert_eq(tokpiece.encode(w, "漢字kanji"), [1, 1, 1])
            test.assert_eq(tokpiece.encode(w, "ﬁne ①"), [1, 1])

@test
fn test_a_tokenizer_json_loads_to_the_same_wordpiece_cased() [io]
    match tokmodel.of_tokenizer_json(WP_CASED_JSON)
        Err(e) => test.fail(e.message())
        Ok(m)  =>
            test.assert_eq(tokmodel.model_name(m), "WordPiece")
            test.assert_eq(tokmodel.encode(m, "Hello, world!").ids, [151, 12, 150, 5])
            test.assert_eq(tokmodel.encode(m, "The quick brown fox").ids, [137, 212, 237, 155, 230, 87, 194, 124])
            test.assert_eq(tokmodel.encode(m, "don't stop").ids, [189, 87, 8, 50, 49, 256, 110])
            test.assert_eq(tokmodel.encode(m, "  leading and trailing  ").ids,
                [42, 86, 142, 135, 91, 172, 50, 89, 81, 88, 97, 135, 91])
            test.assert_eq(tokmodel.encode(m, "a    b").ids, [31, 32])
            test.assert_eq(tokmodel.encode(m, "12345 and 678").ids, [174, 253, 104, 172, 1])
            test.assert_eq(tokmodel.encode(m, "café naïve façade").ids,
                [188, 107, 205, 123, 242, 193, 126, 142, 86])
            test.assert_eq(tokmodel.encode(m, "日本語のテキスト").ids, [78, 79, 80, 223, 114, 166])
            test.assert_eq(tokmodel.encode(m, "tab\there\nnew line").ids,
                [50, 143, 197, 86, 207, 118, 42, 135, 86])
            test.assert_eq(tokmodel.encode(m, "price: \$5.00").ids, [46, 89, 88, 105, 86, 21, 7, 19, 13, 173])
            test.assert_eq(tokmodel.encode(m, "x").ids, [54])
            test.assert_eq(tokmodel.encode(m, "It's we're THEY'LL").ids, [176, 8, 49, 219, 8, 128, 1, 8, 1])
            test.assert_eq(tokmodel.encode(m, "emoji 😀 end").ids, [1, 1, 35, 87, 93])
            test.assert_eq(tokmodel.encode(m, "def add(a, b):\n    return a + b").ids,
                [190, 108, 153, 93, 9, 31, 12, 32, 10, 21, 128, 257, 31, 11, 32])
            test.assert_eq(tokmodel.encode(m, "unaffable").ids, [140, 171, 170])
            test.assert_eq(tokmodel.encode(m, "Ünïcödé ÀÉÎ").ids, [1, 1])
            test.assert_eq(tokmodel.encode(m, "\n\n\nthree breaks").ids,
                [50, 95, 89, 86, 86, 155, 86, 81, 85, 90])
            test.assert_eq(tokmodel.encode(m, "end.").ids, [35, 87, 93, 13])
            test.assert_eq(tokmodel.encode(m, "").ids, [])

