// tokunigram.nv — SentencePiece's unigram model.
//
// A DIFFERENT IDEA FROM BPE, and the difference is worth stating because
// the two are usually presented as interchangeable.  BPE builds a
// tokenisation greedily from the bottom: start with bytes, merge the
// best pair, repeat.  Unigram works from the top: every piece in the
// vocabulary carries a LOG PROBABILITY, and the tokenisation of a word
// is the segmentation whose pieces' probabilities multiply to the
// largest number.
//
// That is a shortest-path problem, and the algorithm is Viterbi over the
// word's positions: `best[i]` is the score of the best segmentation of
// the first `i` bytes, and it is `max` over every piece ending at `i` of
// `best[i - len(piece)] + score(piece)`.  One pass forward, one walk
// back.  Linear in the length times the number of pieces that can end at
// a position, and exact — there is no greedy approximation in it.
//
// WHAT THAT BUYS: unigram can produce a segmentation BPE cannot reach,
// because BPE's early merges constrain its later ones and unigram has no
// history.  It is also why SentencePiece can sample alternative
// segmentations of the same text for training augmentation, which BPE
// cannot do without a separate dropout mechanism.
//
// WHITESPACE IS A CHARACTER.  SentencePiece's defining trick: replace
// every space with `▁` (U+2581) before doing anything, and treat the
// result as one unbroken string with no pre-tokenization at all.  A
// space is then part of a piece rather than a boundary between pieces,
// which is what makes the model language-independent — it works the same
// on text that does not put spaces between words.  Decoding replaces
// `▁` with a space again, and the leading one is dropped.
//
// BYTE FALLBACK.  A modern SentencePiece model includes the 256 tokens
// `<0x00>` through `<0xFF>` and falls back to them for anything its
// pieces cannot cover, which makes it lossless the way byte-level BPE
// is.  An older one has only `<unk>` and loses those bytes.  Both are
// here, and `byte_fallback` is which.
//
// NO EFFECTS.

use tokvocab
use tokfault
use tokutf8
use std.str
use std.list
use std.json

// One piece of a unigram vocabulary: its text and its score.
//
// ```novo
// use tokunigram
//
// fn main() [io]
//     println("${tokunigram.piece("▁the", 0.0 - 3.5).score}")
// ```
pub struct TokPiece
    // The piece's text, with spaces already written as `▁`.
    text: Str
    // Its LOG probability — a negative number, and larger (closer to
    // zero) is more likely.  Log rather than probability so that
    // scoring a segmentation is a sum rather than a product, which does
    // not underflow on a long word.
    score: Float

// A SentencePiece unigram tokenizer.
//
// ```novo
// use tokunigram
// use tokvocab
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [], 0)
//     println("${u.unk_id}")
// ```
pub struct TokUnigram
    // The pieces and their ids.
    vocab: TokVocab
    // The score of the piece with each id, in id order.  Parallel to the
    // vocabulary rather than inside it, because the other two models
    // have no scores and `TokVocab` is shared by all three.
    scores: [Float]
    // The id of `<unk>`.  Used when a byte cannot be covered and
    // `byte_fallback` is off.
    unk_id: Int
    // Whether the model carries the 256 `<0xNN>` tokens and falls back
    // to them.  When it does, the tokenizer is lossless; when it does
    // not, unknown bytes become one `<unk>` and are gone.
    byte_fallback: Bool
    // Whether a `▁` is added at the start of the text before
    // segmenting.  SentencePiece's `add_dummy_prefix`, on by default —
    // which is why `"hello"` and `" hello"` usually tokenise the same.
    add_dummy_prefix: Bool
    // The lowest score among the pieces other than the unknown one.  A
    // character no piece covers scores a fixed penalty below it.
    min_score: Float

// A unigram tokenizer from pieces and scores.
//
// ```novo
// use tokunigram
// use tokvocab
//
// fn main() [io]
//     println("${tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0], 0).unk_id}")
// ```
pub fn of_pieces(vocab: TokVocab, scores: [Float], unk_id: Int) -> TokUnigram
    var low = 0.0
    var first = true
    for k in 0..list.len(scores)
        if k != unk_id and (first or scores[k] < low)
            low = scores[k]
            first = false
    TokUnigram { vocab: vocab, scores: list.clone(scores), unk_id: unk_id, byte_fallback: false,
                 add_dummy_prefix: true, min_score: low }

// A unigram tokenizer from a `tokenizer.json`'s `model.vocab` array:
// `[["piece", score], …]`, id = position.
//
// The form a HuggingFace-converted SentencePiece model arrives in, and
// the one a caller who downloaded `tokenizer.json` already holds.
// `TokMissingScore` for an entry with no score, because segmentation
// maximises over scores and defaulting one would change the answer
// silently.
//
// ```novo
// use tokunigram
//
// fn main() [io]
//     match tokunigram.of_json_pieces("[[\"a\", -1.0]]", 0)
//         Ok(u)  => println("${u.unk_id}")
//         Err(_) => println("refused")
// ```
pub fn of_json_pieces(pieces_json: Str, unk_id: Int) -> Result<TokUnigram, TokFault>
    let Some(root) = json.parse(pieces_json) else return Err(TokMalformedJson(0, "well-formed JSON"))
    let Some(items) = json.to_list(root) else return Err(TokMalformedJson(0, "an array of [piece, score] pairs"))
    var pieces: [Str] = []
    var scores: [Float] = []
    for item in items
        let Some(entry) = json.to_list(item) else return Err(TokMalformedJson(0, "a [piece, score] pair"))
        if list.len(entry) == 0
            return Err(TokMalformedJson(0, "a [piece, score] pair"))
        let Some(text) = json.to_str(entry[0]) else return Err(TokMalformedJson(0, "a string piece"))
        if list.len(entry) < 2
            return Err(TokMissingScore(text))
        let Some(score) = json.to_float(entry[1]) else return Err(TokMissingScore(text))
        list.push(pieces, text)
        list.push(scores, score)
    Ok(of_pieces(tokvocab.of_tokens(pieces), scores, unk_id))

// A piece and its score.
//
// ```novo
// use tokunigram
//
// fn main() [io]
//     println(tokunigram.piece("▁the", 0.0 - 3.5).text)
// ```
pub fn piece(text: Str, score: Float) -> TokPiece
    TokPiece { text: text, score: score }

// The same tokenizer with byte fallback on or off.
//
// ```novo
// use tokunigram
// use tokvocab
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0], 0)
//     println("${tokunigram.with_byte_fallback(u, true).byte_fallback}")
// ```
pub fn with_byte_fallback(u: TokUnigram, on: Bool) -> TokUnigram
    TokUnigram { vocab: u.vocab, scores: u.scores, unk_id: u.unk_id, byte_fallback: on,
                 add_dummy_prefix: u.add_dummy_prefix, min_score: u.min_score }

// The same tokenizer with the dummy prefix on or off.
//
// ```novo
// use tokunigram
// use tokvocab
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0], 0)
//     println("${tokunigram.with_dummy_prefix(u, false).add_dummy_prefix}")
// ```
pub fn with_dummy_prefix(u: TokUnigram, on: Bool) -> TokUnigram
    TokUnigram { vocab: u.vocab, scores: u.scores, unk_id: u.unk_id, byte_fallback: u.byte_fallback,
                 add_dummy_prefix: on, min_score: u.min_score }

// The score of a piece, or the most negative number when the vocabulary
// has none.
//
// The sentinel rather than an optional, because this is the inner loop
// of the Viterbi pass and "impossible" composes correctly with `max`:
// a path through a piece that does not exist never wins.
//
// ```novo
// use tokunigram
// use tokvocab
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0 - 1.0], 0)
//     println("${tokunigram.score_of(u, "a")}")
// ```
pub fn score_of(u: TokUnigram, piece: Str) -> Float
    let id = tokvocab.id_of(u.vocab, piece)
    if id < 0 or id >= list.len(u.scores)
        return IMPOSSIBLE
    u.scores[id]

// Text with every space written as `▁` and, if asked, one added at the
// start.
//
// SentencePiece's normalisation, as its own function because it is the
// step that decides whether `"hello"` and `" hello"` tokenise the same —
// and because a caller comparing this package against the reference
// compares this first.
//
// ```novo
// use tokunigram
//
// fn main() [io]
//     println(tokunigram.to_sentencepiece_space("hello world", true))
// ```
pub fn to_sentencepiece_space(text: Str, add_dummy_prefix: Bool) -> Str
    let spaced = str.replace(text, " ", MARK)
    if add_dummy_prefix
        return MARK + spaced
    spaced

// A `▁`-spaced string back to ordinary text.
//
// Every `▁` becomes a space, and a single LEADING one is dropped —
// which is the rule that makes `decode(encode(s))` give back `s` rather
// than `" " + s` when the dummy prefix was added.
//
// ```novo
// use tokunigram
//
// fn main() [io]
//     println(tokunigram.from_sentencepiece_space("▁hello▁world"))
// ```
pub fn from_sentencepiece_space(text: Str) -> Str
    let spaced = if str.starts_with(text, MARK)
        str.slice(text, str.len(MARK), str.len(text))
    else
        text
    str.replace(spaced, MARK, " ")

// The best segmentation of one `▁`-spaced string, as pieces.  A run of
// neighbouring characters that no piece spells is one piece, written as the
// characters themselves.
//
// THE VITERBI PASS, public because it is the algorithm and the thing to
// test: a segmentation that differs from the reference's differs here,
// and comparing pieces is a readable diff where comparing ids is not.
//
// ```novo
// use tokunigram
// use tokvocab
// use std.list
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0 - 1.0], 0)
//     println("${list.len(tokunigram.best_path(u, "▁hello"))}")
// ```
pub fn best_path(u: TokUnigram, text: Str) -> [Str]
    let (pieces, _) = segment(u, text)
    pieces

// The score the best segmentation achieves: the sum of its pieces' log
// probabilities.
//
// Comparable ACROSS SEGMENTATIONS of the same text and not across
// different texts — a longer string has more pieces and so a more
// negative sum, which says nothing about how well it was tokenised.
//
// ```novo
// use tokunigram
// use tokvocab
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0 - 1.0], 0)
//     println("${tokunigram.best_score(u, "▁hello")}")
// ```
pub fn best_score(u: TokUnigram, text: Str) -> Float
    let n = str.len(text)
    if n == 0
        return 0.0
    var total = 0.0
    let (pieces, unknown) = segment(u, text)
    for k in 0..list.len(pieces)
        let score = if unknown[k]
            u.min_score - UNK_PENALTY
        else
            piece_score(u, pieces[k])
        total = round32(total + round32(score))
    total

// Text as token ids.
//
// Total when `byte_fallback` is on: a character no piece spells is written
// as the `<0xNN>` pieces of its bytes.  With it off, a run of neighbouring
// characters no piece spells becomes one `<unk>` and is not recoverable,
// which is the older SentencePiece behaviour and the reason `byte_fallback`
// is a field rather than an assumption.
//
// ```novo
// use tokunigram
// use tokvocab
// use std.list
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0 - 1.0], 0)
//     println("${list.len(tokunigram.encode(u, "hello"))}")
// ```
pub fn encode(u: TokUnigram, text: Str) -> [Int]
    let (ids, _, _) = pieces_with_spans(u, text)
    ids

// Text as token strings, `▁` and all.
//
// ```novo
// use tokunigram
// use tokvocab
// use std.list
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0 - 1.0], 0)
//     println("${list.len(tokunigram.tokenize(u, "hello"))}")
// ```
pub fn tokenize(u: TokUnigram, text: Str) -> [Str]
    let (_, tokens, _) = pieces_with_spans(u, text)
    tokens

// Token ids back to text, with `▁` turned back into spaces.
//
// ```novo
// use tokunigram
// use tokvocab
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["a"]), [0.0 - 1.0], 0)
//     match tokunigram.decode(u, [0])
//         Ok(s)  => println(s)
//         Err(_) => println("refused")
// ```
pub fn decode(u: TokUnigram, ids: [Int]) -> Result<Str, TokFault>
    let sb = str.builder_new()
    var failure: ?TokFault = None
    for id in ids
        if id < 0 or id >= tokvocab.size(u.vocab)
            failure = Some(TokIdOutOfRange(id, tokvocab.size(u.vocab)))
            break
        let piece = tokvocab.token_of(u.vocab, id)
        let byte = byte_of_piece(piece)
        if byte >= 0
            str.builder_append_char(sb, byte)
        else
            str.builder_append(sb, piece)
    let joined = str.builder_to_str(sb)
    str.builder_drop(sb)
    match failure
        Some(f) => Err(f)
        None    =>
            let text = if u.add_dummy_prefix
                from_sentencepiece_space(joined)
            else
                str.replace(joined, MARK, " ")
            Ok(text)

// The character that stands for a space, U+2581 LOWER ONE EIGHTH BLOCK.
const MARK = "▁"

// SentencePiece scores a character no piece covers at this much below the
// lowest piece score.
const UNK_PENALTY = 10.0

// The score of a segmentation that cannot be made.  It is far below any sum
// of real scores and still a number that `+` leaves alone.
const IMPOSSIBLE = 0.0 - 1.0e18

fn score_at(u: TokUnigram, id: Int) -> Float
    if id < list.len(u.scores)
        return u.scores[id]
    IMPOSSIBLE

// The score of a piece the vocabulary spells.
fn piece_score(u: TokUnigram, piece: Str) -> Float
    score_at(u, tokvocab.id_of(u.vocab, piece))

// The ids a character that no piece covers is encoded as: its bytes when the
// model has byte fallback and carries them, otherwise the unknown id.
fn unknown_ids(u: TokUnigram, text: Str) -> [Int]
    var out: [Int] = []
    if u.byte_fallback
        for k in 0..str.len(text)
            let id = tokvocab.id_of(u.vocab, byte_piece(str.byte_at_or(text, k, 0)))
            out = list.push(out, (if id >= 0 then id else u.unk_id))
        return out
    out = list.push(out, u.unk_id)
    out

// The name of the piece that stands for one byte: `<0x0A>`.
fn byte_piece(b: Int) -> Str
    let digits = "0123456789ABCDEF"
    "<0x" + str.slice(digits, b >> 4, (b >> 4) + 1) + str.slice(digits, b & 15, (b & 15) + 1) + ">"

// The byte a `<0xNN>` piece stands for, or -1 for any other piece.
fn byte_of_piece(piece: Str) -> Int
    if str.len(piece) != 6 or not str.starts_with(piece, "<0x") or not str.ends_with(piece, ">")
        return 0 - 1
    let hi = hex_value(str.byte_at_or(piece, 3, 0))
    let lo = hex_value(str.byte_at_or(piece, 4, 0))
    if hi < 0 or lo < 0
        return 0 - 1
    hi * 16 + lo

fn hex_value(b: Int) -> Int
    if b >= '0' and b <= '9'
        return b - '0'
    if b >= 'A' and b <= 'F'
        return b - 'A' + 10
    0 - 1

// Rounds to the nearest 32-bit float.  SentencePiece keeps scores and sums
// them in 32 bits, and two segmentations whose sums are equal in exact
// arithmetic are told apart by that rounding.
fn round32(x: Float) -> Float
    let y = x as fp32
    y as Float

// The Viterbi pass: the pieces of the best segmentation of a `▁`-spaced
// string, and for each whether it is a run of characters no piece covers.
// Neighbouring uncovered characters are one piece, as SentencePiece joins
// them.
fn segment(u: TokUnigram, text: Str) -> ([Str], [Bool])
    var out: [Str] = []
    var unknown: [Bool] = []
    let n = str.len(text)
    if n == 0
        return (out, unknown)
    var best: [Float] = []
    var from: [Int] = []
    var via: [Int] = []
    for _ in 0..n + 1
        list.push(best, IMPOSSIBLE)
        list.push(from, 0 - 1)
        list.push(via, 0 - 1)
    best[0] = 0.0
    let unk_score = round32(u.min_score - UNK_PENALTY)
    var i = 0
    while i < n
        let width = tokutf8.length_at(text, i)
        if best[i] > IMPOSSIBLE
            var single = false
            var probe = str.slice(text, i, n)
            while str.len(probe) > 0
                let (tok, id) = tokvocab.longest_prefix(u.vocab, probe, 0)
                if id < 0
                    break
                let j = i + str.len(tok)
                let score = round32(best[i] + round32(score_at(u, id)))
                if score > best[j]
                    best[j] = score
                    from[j] = i
                    via[j] = id
                if str.len(tok) == width
                    single = true
                probe = str.slice(probe, 0, str.len(tok) - 1)
            // A character no piece spells on its own is reachable as
            // unknown, at the unknown score.
            if not single
                let j = i + width
                let score = round32(best[i] + unk_score)
                if score > best[j]
                    best[j] = score
                    from[j] = i
                    via[j] = 0 - 1
        i = i + width
    var j = n
    while j > 0 and from[j] >= 0
        let start = from[j]
        if via[j] < 0 and list.len(unknown) > 0 and unknown[list.len(unknown) - 1]
            // The piece after this one is also unknown, so they are one.
            out[list.len(out) - 1] = str.slice(text, start, j) + out[list.len(out) - 1]
        else
            list.push(out, str.slice(text, start, j))
            list.push(unknown, via[j] < 0)
        j = start
    (list.rev(out), list.rev(unknown))

// The ids and token strings of the text, and where each token sits in it as
// `start, length` pairs in bytes of the original text.
//
// An added token is one token covering its own text.  The dummy prefix
// belongs to the start of the whole text.  A character that is encoded as
// several byte tokens gives each of them the character's span.
//
// ```novo
// use tokunigram
// use tokvocab
// use std.list
//
// fn main() [io]
//     let u = tokunigram.of_pieces(tokvocab.of_tokens(["<unk>", "▁a"]), [0.0, 0.0 - 1.0], 0)
//     let (ids, tokens, spans) = tokunigram.pieces_with_spans(u, "a")
//     println("${list.len(ids)} ${list.len(tokens)} ${list.len(spans)}")
// ```
pub fn pieces_with_spans(u: TokUnigram, text: Str) -> ([Int], [Str], [Int])
    var ids: [Int] = []
    var tokens: [Str] = []
    var spans: [Int] = []
    let cuts = tokvocab.split_on_added(u.vocab, text)
    for t in 0..list.len(cuts) / 3
        let lo = cuts[3 * t]
        let hi = cuts[3 * t + 1]
        if cuts[3 * t + 2] >= 0
            list.push(ids, cuts[3 * t + 2])
            list.push(tokens, str.slice(text, lo, hi))
            list.push(spans, lo)
            list.push(spans, hi - lo)
        else
            add_stretch(u,
                str.slice(text, lo, hi),
                lo,
                t == 0 and u.add_dummy_prefix,
                var ids,
                var tokens,
                var spans)
    (ids, tokens, spans)

fn add_stretch(u: TokUnigram, stretch: Str, base: Int, prefix: Bool, var ids: [Int],
               var tokens: [Str], var spans: [Int])
    // The stretch with its spaces written as the mark, and for each byte of
    // that the span of the original character it came from.
    let sb = str.builder_new()
    var from: [Int] = []
    var to: [Int] = []
    if prefix
        str.builder_append(sb, MARK)
        for _ in 0..str.len(MARK)
            list.push(from, 0)
            list.push(to, 0)
    let cps = tokutf8.codes(stretch)
    let starts = tokutf8.starts(stretch)
    for k in 0..list.len(cps)
        let piece = if cps[k] == 32
            MARK
        else
            tokutf8.encode(cps[k])
        str.builder_append(sb, piece)
        for _ in 0..str.len(piece)
            list.push(from, starts[k])
            list.push(to, starts[k + 1])
    let spaced = str.builder_to_str(sb)
    str.builder_drop(sb)
    let (pieces, unknown) = segment(u, spaced)
    var at = 0
    for k in 0..list.len(pieces)
        let width = str.len(pieces[k])
        let found = if unknown[k]
            []
        else
            [tokvocab.id_of(u.vocab, pieces[k])]
        let these = if unknown[k]
            unknown_ids(u, pieces[k])
        else
            found
        for id in these
            list.push(ids, id)
            list.push(tokens, tokvocab.token_of(u.vocab, id))
            list.push(spans, base + from[at])
            list.push(spans, to[at + width - 1] - from[at])
        at = at + width
